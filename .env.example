# ===== ギャグ生成 =====
# gemini（無料枠あり） / anthropic（有料） / mock（AIなし・確認用）
# 未指定なら、キーがある方を自動で使い、どちらも無ければ mock。
GAG_PROVIDER=gemini
# Google AI Studio（aistudio.google.com）で無料発行
GEMINI_API_KEY=
# 任意：モデル名
GEMINI_MODEL=gemini-3.8-flash
# GAG_PROVIDER=anthropic のときのみ
ANTHROPIC_API_KEY=

# ===== 画像生成 =====
# pollinations（無料・キー不要） / openai（有料）
IMAGE_PROVIDER=pollinations
# IMAGE_PROVIDER=openai のときのみ
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
